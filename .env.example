# Kopiraj u .env.local i popuni. .env* fajlovi se nikad ne commit-uju.

NODE_ENV=development
# Prihvata i goli domen (komanda-ai.vercel.app) — shema se dodaje sama.
# Na Vercel-u se, ako se izostavi, izvodi iz VERCEL_URL.
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# --- Supabase ---
# Ove dve varijable smeju u browser (anon ključ nema prava nad tabelama).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Zaobilazi RLS. Samo za migracije, seed i pozadinske poslove.
# Nikad ne sme da završi u klijentskom bundle-u.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provajder ---
# 'none' dok se AI sloj ne uključi (Faza 5).
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Bezbednost ---
IMPERSONATION_MAX_MINUTES=60

# --- Zakazani poslovi ---
# Bez nje ruta za nadzor NE POSTOJI — radije nedostupna nego otvorena.
# Napravi je sa: openssl rand -hex 32
CRON_SECRET=

# --- Prijem podataka poštom (Mailgun EU) ---
# Domen namenskih adresa oblika uvoz+<token>@domen.
MAIL_DOMAIN=
# Tajna kojom se dobavljač pošte predstavlja. openssl rand -hex 32
MAIL_WEBHOOK_SECRET=
# „HTTP webhook signing key" iz Mailgun podešavanja — NIJE isti kao API ključ.
MAILGUN_SIGNING_KEY=
